    <DatatypeProperty rdf:about="https://dlnarratives.eu/ontology#has_note">
        <rdfs:domain rdf:resource="https://dlnarratives.eu/ontology#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This property relates an entity to a note about it. Equivalent to the CRM property P3 has note.</rdfs:comment>
    </DatatypeProperty>
    


