        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Physical_Human_Made_Thing"/>
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Tangible_Heritage_Entity"/>
        <rdfs:comment>A rock engraving is a physical human-made thing.</rdfs:comment>
        <rdfs:comment>A tangible rock engraving, distinct from the visual item shown.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Role -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Role">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Entity"/>
