    <!-- https://dlnarratives.eu/ontology#Monastery -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Monastery">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Building"/>
        <rdfs:comment>A physical monastery building.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Narration -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Narration">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Individual_Work"/>
        <rdfs:comment>This class represents the narration of a narrative, i.e. an individual work that tells the events of the narrative through some form of media (text, video, audio, etc.).</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Narrative -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Narrative">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Information_Object"/>
        <rdfs:comment>This class represents a narrative.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Observable_Entity -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Observable_Entity">
        <rdfs:comment>This class represents an observable entity. Equivalent to the CRMinf class S15 Observable Entity.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Observation -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Observation">
        <rdfs:comment>This class represents an observation. Equivalent to the CRMinf class S4 Observation.</rdfs:comment>
    </Class>
    


