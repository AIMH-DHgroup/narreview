    <Class rdf:about="https://dlnarratives.eu/ontology#Identifier"/>
    


    <!-- https://dlnarratives.eu/ontology#Individual_Work -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Individual_Work"/>
    


    <!-- https://dlnarratives.eu/ontology#Inference_Making -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Inference_Making">
        <rdfs:comment>This class represents an inference making. Equivalent to the CRMinf class I5 Inference Making.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Information_Object -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Information_Object">
        <rdfs:comment>This class represents an information object. Equivalent to the CRM class E73 Information Object.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Inscription -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Inscription">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Linguistic_Object"/>
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Mark"/>
        <rdfs:comment>An inscription is also a mark.</rdfs:comment>
        <rdfs:comment>Equivalent to CRM E34 Inscription: the symbolic inscription, not its physical carrier.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Instant -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Instant">
        <rdfs:comment>This class is equivalent to the class time:Instant</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Intangible_Heritage_Entity -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Intangible_Heritage_Entity">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Heritage_Entity"/>
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Propositional_Object"/>
        <rdfs:comment>An intangible heritage entity is also a propositional object.</rdfs:comment>
        <rdfs:comment>Equivalent to the HDT class HC4 Intangible Heritage Entity.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Joining -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Joining">
        <rdfs:comment>This class represents a joining. Equivalent to the CRM class E85 Joining.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Leaving -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Leaving">
        <rdfs:comment>This class represents a leaving. Equivalent to the CRM class E86 Leaving.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Linguistic_Object -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Linguistic_Object">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Information_Object"/>
        <rdfs:comment>Equivalent to CRM E33 Linguistic Object.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Mark -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Mark">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Visual_Item"/>
        <rdfs:comment>Equivalent to CRM E37 Mark.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Material -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Material">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Type"/>
        <rdfs:comment>Equivalent to CRM E57 Material.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Model_3D -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Model_3D">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Digital_Representation"/>
        <rdfs:comment>Equivalent to the HDT class HC8 3D Model.</rdfs:comment>
