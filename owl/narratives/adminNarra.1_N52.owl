        <rdfs:comment>Equivalent to the HDT class HC16 Heritage Proposition Set.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Human_Made_Thing -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Human_Made_Thing">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Thing"/>
        <rdfs:comment>Equivalent to CRM E71 Man-Made Thing.</rdfs:comment>
    </Class>
    


