    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Physical_Human_Made_Thing -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Physical_Human_Made_Thing">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Human_Made_Thing"/>
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Physical_Thing"/>
        <rdfs:comment>A physical human-made thing is also human-made.</rdfs:comment>
        <rdfs:comment>Equivalent to CRM E24 Physical Man-Made Thing.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Physical_Object -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Physical_Object">
        <rdfs:comment>This class represents a physical object. Equivalent to the CRM class E19 Physical Object.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Physical_Thing -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Physical_Thing">
        <rdfs:comment>This class represents a physical thing. Equivalent to the CRM class E18 Physical Thing.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Place -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Place">
        <rdfs:comment>This class represents a place. Equivalent to the CRM class E53 Place.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Production -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Production">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Activity"/>
        <rdfs:comment>Equivalent to CRM E12 Production.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Proposition -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Proposition">
        <rdfs:subClassOf rdf:resource="https://dlnarratives.eu/ontology#Entity"/>
