    <Class rdf:about="https://dlnarratives.eu/ontology#Persistent_Item">
        <rdfs:comment>This class represents a persistent item. Equivalent to the CRM class E77 Persistent Item.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Person -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Person">
        <rdfs:comment>This class represents a person. Equivalent to the CRM class E21 Person.</rdfs:comment>
    </Class>
    


    <!-- https://dlnarratives.eu/ontology#Phenomenal_Place -->


    <Class rdf:about="https://dlnarratives.eu/ontology#Phenomenal_Place">
