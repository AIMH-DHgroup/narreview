        <ontology:has_preferred_identifier rdf:resource="https://tool.dlnarratives.eu/storymaps/adminNarra.1/N52/"/>
        <rdfs:label>The Roman Amphitheatre in Segobriga (Ema)</rdfs:label>
    </NamedIndividual>
    


    <!-- https://dlnarratives.eu/narrative/N52/creation -->


